# ============================================================
#  antinet .gitignore — 补全版
#  整合所有应忽略的规则，消除重复
# ============================================================

# =========================
#  打包生成文件
# =========================
dist_package/
backend/build/
backend/dist/
*.exe
*.pkg
*.pyz

# =========================
#  根目录误生成的目录
# =========================
/C:/

# =========================
#  操作系统
# =========================
.DS_Store
Thumbs.db
Desktop.ini
nul

# =========================
#  编辑器 / IDE
# =========================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# =========================
#  AI 助手配置
# =========================
.claude/
.cursor/
.windsurf/
.codebuddy/
.roomodes

# =========================
#  Node.js
# =========================
node_modules/
dist/
dist-ssr/
build/
*.local
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# =========================
#  Python 虚拟环境 & 缓存
# =========================
venv/
venv_arm64/
venv_x64/
venv_stt/
venv_mineru/
backend/venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.pyo
*.pyd

# =========================
#  第三方库（不应提交到仓库）
# =========================
backend/site-packages/

# =========================
#  环境变量
# =========================
.env
.env.local
.env.*.local

# =========================
#  日志
# =========================
logs/
*.log

# =========================
#  临时文件
# =========================
*.tmp
*.temp
.cache/
tmpclaude-*

# =========================
#  备份文件
# =========================
*.bak
*.backup
*.before_merge*
*.before_recovery*
backup_*/

# =========================
#  文件副本 / 旧版本变体
# =========================
*副本*
* copy.*
* copy *
*_original.*
*_cleaned.*
*_fixed.*
*(*).tsx
*(*).ts
*(*).py

# =========================
#  数据库文件
# =========================
*.db
backend/data/
data/
!backend/data/demo/

# =========================
#  用户上传 / 导出数据
